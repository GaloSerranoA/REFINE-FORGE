{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refineforge.local/schemas/agent-report.schema.json",
  "title": "Refine-Forge Agent Report",
  "type": "object",
  "required": [
    "schema_version",
    "agent",
    "mode",
    "target",
    "liveness",
    "runtime",
    "production_proof",
    "capabilities",
    "tool_checks",
    "started_at",
    "finished_at",
    "status",
    "trust_level",
    "commands",
    "changed_files",
    "artifacts",
    "blockers",
    "warnings",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "agent-report-v1"
    },
    "agent": {
      "enum": ["lean", "devops", "train", "kernel", "run_all"]
    },
    "mode": {
      "enum": ["inspect", "check", "repair", "execute"]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "liveness": {
      "type": "object",
      "required": ["state", "checked_at", "agent", "mode", "target", "command_surface"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "alive"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "agent": {
          "enum": ["lean", "devops", "train", "kernel", "run_all"]
        },
        "mode": {
          "enum": ["inspect", "check", "repair", "execute"]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "command_surface": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "runtime_version",
        "agent",
        "mode",
        "target",
        "authority",
        "trust_ceiling",
        "action_intents",
        "evidence_receipts",
        "policy_decisions",
        "typed_blockers"
      ],
      "additionalProperties": false,
      "properties": {
        "runtime_version": {
          "const": "agent-runtime-v1"
        },
        "agent": {
          "enum": ["lean", "devops", "train", "kernel", "run_all"]
        },
        "mode": {
          "enum": ["inspect", "check", "repair", "execute"]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "object",
          "required": [
            "source_of_truth",
            "prompt_authority",
            "memory_authority",
            "human_review_rule"
          ],
          "additionalProperties": false,
          "properties": {
            "source_of_truth": {
              "const": "cli_report"
            },
            "prompt_authority": {
              "const": "advisory_only"
            },
            "memory_authority": {
              "const": "non_authoritative"
            },
            "human_review_rule": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "trust_ceiling": {
          "enum": [
            "blocked",
            "measured-only",
            "model-only",
            "model-linked",
            "release-ready-local",
            "release-ready-ci",
            "human-reviewed"
          ]
        },
        "action_intents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "category",
              "mutation_policy",
              "command_surface",
              "evidence_required"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "mutation_policy": {
                "type": "string",
                "minLength": 1
              },
              "command_surface": {
                "type": "string",
                "minLength": 1
              },
              "evidence_required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "evidence_receipts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "kind", "subject", "status", "sha256", "detail"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": ["artifact", "command", "tool_check"]
              },
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "policy_decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "status", "detail"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "typed_blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "severity", "detail"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "production_proof": {
      "type": "object",
      "required": [
        "agent",
        "profile",
        "status",
        "trust_effect",
        "requirements",
        "reviewer_evidence",
        "blockers"
      ],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "enum": ["lean", "devops", "train", "kernel", "run_all"]
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z_]+-production-proof$"
        },
        "status": {
          "enum": ["blocked", "partial", "ready", "human-reviewed"]
        },
        "trust_effect": {
          "const": "bounded-by-evidence"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "description", "status", "evidence"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": ["passed", "failed", "blocked", "partial"]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "reviewer_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["available", "tool_gated", "evidence_only"]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tool_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "required", "status", "detail"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": ["available", "skipped", "required", "not_checked"]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["passed", "failed", "blocked", "partial"]
    },
    "trust_level": {
      "enum": [
        "blocked",
        "measured-only",
        "model-only",
        "model-linked",
        "release-ready-local",
        "release-ready-ci",
        "human-reviewed"
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
