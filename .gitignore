# Rust
/target/
.worktrees/

# Lean
lean/.lake/
lean/lake-packages/
lean/build/
# Auto-generated by `lake build` on first run. refineforge has no
# Lake-package deps today (packages list is empty); the bundle
# export re-generates this via its own `lake build` invocation.
# If/when Mathlib lands, revisit — at that point the manifest IS
# trust-base critical and should be committed.
lean/lake-manifest.json

# editor
.idea/
.vscode/
*.swp
.DS_Store
__pycache__/
*.pyc

# generated artifacts are committed selectively; ignore by default
/artifacts/*/manifest.json.tmp

# eval run outputs — produced by refine-eval, not committed
/eval/runs/

# Agent control-plane run outputs
/agent-reports/

# Enterprise readiness report outputs
/enterprise-readiness/

# InmortalProof proof-search run outputs
/inmortal-proof-runs/

# DevOps / production-proof evidence packs (downloaded CI artifacts; local
