# Rust
/target/
.worktrees/

# Lean
lean/.lake/
lean/lake-packages/
lean/build/
# Auto-generated by `lake build` on first run. refineforge has no
# Lake-package deps today (packages list is empty); the bundle
# export re-generates this via its own `lake build` invocation.
# If/when Mathlib lands, revisit — at that point the manifest IS
# trust-base critical and should be committed.
lean/lake-manifest.json

# editor
.idea/
.vscode/
*.swp
.DS_Store
__pycache__/
*.pyc

# generated artifacts are committed selectively; ignore by default
/artifacts/*/manifest.json.tmp

# eval run outputs — produced by refine-eval, not committed
/eval/runs/

# Agent control-plane run outputs
/agent-reports/

# Enterprise readiness report outputs
/enterprise-readiness/

# InmortalProof proof-search run outputs
/inmortal-proof-runs/

# DevOps / production-proof evidence packs (downloaded CI artifacts; local
# validation inputs for the agents, not source)
/production-proof/

# Nix
result
result-*
.direnv/

# Bit-exact gate run outputs
/kernels/runs/*/

# Trainer run outputs
/training/runs/*/
/training/data/**/anthropic-sft.raw-*.jsonl

# throwaway CI poll helper (session tooling)
/poll_ci.sh

# Downloaded model weights — multi-GB, operator-provided (the prover backend
# points at a locally-served model via config/CLI). Never committed to git.
/models/
*.gguf
*.safetensors

# Lean verifier project (matched to Goedel-Prover-V2): the Mathlib clone + oleans
# (multi-GB, fetched by `lake exe cache get`) and the per-verification candidate
# file the prover backend overwrites. The scaffold (lakefile, toolchain, README,
# Smoke.lean, ProverVerify.lean) IS committed.
/lean-prover-verify/.lake/
/lean-prover-verify/lake-packages/
/lean-prover-verify/ProverCandidate.lean
